# Variables for docker-compose.yml. In Dokploy, paste these into the Environment tab.

# Postgres runs inside the stack. Use a password without URL special characters,
# for example: openssl rand -hex 24
POSTGRES_USER=codewrapped
POSTGRES_PASSWORD=
POSTGRES_DB=codewrapped

WEB_URL=https://codewrapped.app
API_URL=https://api.codewrapped.app
COOKIE_DOMAIN=.codewrapped.app

# openssl rand -hex 32
BETTER_AUTH_SECRET=

# GitHub OAuth App. Callback URL: https://api.codewrapped.app/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
