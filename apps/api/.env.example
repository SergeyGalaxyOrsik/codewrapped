# Postgres connection string. On Dokploy, copy the internal URL of the Postgres service.
DATABASE_URL=postgres://codewrapped:change-me@codewrapped-db:5432/codewrapped

# Port the server listens on inside the container.
PORT=3000

# Public site URL. The only origin allowed by CORS, and the base for links.
WEB_URL=https://codewrapped.app

# This API's public URL. GitHub redirects to $API_URL/auth/callback/github.
API_URL=https://api.codewrapped.app

# Cookie domain shared by the site and the API. Leave empty for localhost.
COOKIE_DOMAIN=.codewrapped.app

# Random secret for sessions, at least 32 characters: openssl rand -hex 32
BETTER_AUTH_SECRET=

# GitHub OAuth App: github.com/settings/developers
# Homepage URL: $WEB_URL   Authorization callback URL: $API_URL/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
