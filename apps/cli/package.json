{
  "name": "codewrapped",
  "version": "0.3.0",
  "description": "A Wrapped for coding agents. Reads local Claude Code, Codex, Pi, opencode, ZCode and Cursor logs and shows your stats.",
  "keywords": [
    "claude-code",
    "codex",
    "pi",
    "opencode",
    "zcode",
    "cursor",
    "wrapped",
    "stats",
    "cli",
    "ai",
    "coding-agents"
  ],
  "homepage": "https://codewrapped.app",
  "bugs": {
    "url": "https://github.com/SergeyGalaxyOrsik/codewrapped/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergeyGalaxyOrsik/codewrapped.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "SergeyGalaxyOrsik",
  "type": "module",
  "bin": {
    "codewrapped": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codewrapped/brand": "workspace:*",
    "@codewrapped/card": "workspace:*",
    "@codewrapped/parser": "workspace:*",
    "@codewrapped/stats": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "satori": "0.63.2",
    "sql.js": "^1.15.2"
  }
}
