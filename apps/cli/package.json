    "url": "https://github.com/SergeyGalaxyOrsik/codewrapped/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergeyGalaxyOrsik/codewrapped.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "SergeyGalaxyOrsik",
  "type": "module",
  "bin": {
    "codewrapped": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
